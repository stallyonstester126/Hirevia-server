# Application Environment (production | development | test)
ENV=development
NODE_ENV=development

# SERVER
# Railway assigns PORT dynamically at runtime
PORT=3000
SERVER_URL="http://localhost:3000"

# CORS & Frontends (comma-separated list for multi-origin support)
CORS_ORIGINS="http://localhost:3001,http://localhost:3002,http://127.0.0.1:3001,http://127.0.0.1:3002"
CLIENT_URL="http://localhost:3002"
ADMIN_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3002"

# Database (MongoDB Atlas connection string in production)
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# Migration (Optional)
MIGRATE_MONGO_URI=""
MIGRATE_AUTOSYNC="false"

# BCRYPT
SALT_ROUNDS="10"

# EMAIL_SERVICE (Brevo / Sendinblue / Resend)
EMAIL_SERVICE_API_KEY=""
BREVO_API_KEY=""
EMAIL_FROM="Hirevia <notifications@hirevia.com>"
EMAIL_SENDER_NAME="Hirevia"
EMAIL_SENDER_ADDRESS="notifications@hirevia.com"

# Tokens (Use strong, unique 32+ char random strings in production)
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""

# File Uploads
UPLOAD_DIR="uploads"
MAX_FILE_SIZE="10485760" # 10MB in bytes

# AI Provider (Groq Llama-3.3-70b-versatile or openai/gpt-oss-120b)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Stripe (Live or Test mode keys)
STRIPE_PUBKEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Auto-Screening & Assessments
AUTO_SHORTLIST_THRESHOLD="70"
TEST_INVITE_EXPIRY_DAYS="7"

# Vapi AI Voice Interview (Live keys and assistant ID)
VAPI_PRIVATE_KEY=""
VAPI_ASSISTANT_ID=""
VAPI_WEBHOOK_SECRET=""

# Google OAuth 2.0 (Google Cloud Console credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/v1/auth/google/callback"

# Admin Seed Account (CLI Seed only)
ADMIN_SEED_EMAIL="admin@hirevia.com"
ADMIN_SEED_PASSWORD="AdminPass123!"